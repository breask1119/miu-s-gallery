        <div class="flex-1 overflow-y-auto p-5 space-y-4 scroll-smooth overscroll-contain" id="comment-list" aria-live="polite">
          <p class="text-gray-500 font-light text-center py-10">まだコメントはありません。<br/>最初のコメントを投稿しよう！</p>
        </div>

        <div class="p-4 border-t border-white/5 bg-[#09090d] shrink-0 relative pb-[calc(1rem+env(safe-area-inset-bottom))]">
          <div id="reply-indicator" class="hidden absolute top-0 left-4 -translate-y-[calc(100%-1px)] bg-[#121218] border border-white/10 border-b-0 rounded-t-xl px-4 py-1.5 items-center gap-4 z-0 text-xs shadow-lg">
            <span class="text-gray-400 font-light"><span id="reply-indicator-name" class="text-white font-medium"></span> さんに返信中...</span>
            <button id="btn-cancel-reply" class="text-gray-500 hover:text-rose-400 outline-none p-1" aria-label="返信をキャンセル">✕</button>
          </div>

          <div id="comment-form-wrapper" class="relative z-10 bg-[#09090d]">
            <input type="text" id="comment-author" placeholder="名前 (任意)" aria-label="名前" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white text-xs mb-2 outline-none focus:border-rose-500 transition-colors font-light" />
            <div class="flex gap-2">
              <input type="text" id="comment-content" placeholder="コメントを入力..." aria-label="コメント" class="flex-1 bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white text-xs outline-none focus:border-rose-500 transition-colors font-light" />
              <button type="button" id="comment-submit-btn" class="bg-rose-500/80 hover:bg-rose-500 text-white px-4 py-2 rounded-lg text-xs font-medium transition-colors outline-none shrink-0">送信</button>
            </div>
          </div>
