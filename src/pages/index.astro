---
// src/pages/index.astro
import { ClientRouter } from 'astro:transitions';
import '../styles/app.scss';
import '../styles/gallery.css';
import { getGalleryData } from '../lib/wp';

const { siteInfo, sliders, models } = await getGalleryData();

const placeholderImg = "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop";
const wpGraphqlUrl = import.meta.env.PUBLIC_WP_GRAPHQL_URL || '';

const secureUrl = (url: string) => {
  if (!url) return '';
  let httpsUrl = url.replace(/^http:\/\//i, 'https://');
  if (wpGraphqlUrl && !httpsUrl.includes('unsplash.com')) {
    try {
      const wpOrigin = new URL(wpGraphqlUrl).origin;
      const urlObj = new URL(httpsUrl);
      if (urlObj.origin !== wpOrigin) {
        urlObj.protocol = new URL(wpOrigin).protocol;
        urlObj.hostname = new URL(wpOrigin).hostname;
        urlObj.port = new URL(wpOrigin).port;
        return urlObj.toString();
      }
    } catch (e) {}
  }
  return httpsUrl;
};

const hexToRgbString = (hex: string) => {
  const validHex = hex && hex.trim() !== '' ? hex : '#F43F5E';
  let cleanHex = validHex.replace('#', '');
  if (cleanHex.length === 3) {
    cleanHex = cleanHex.split('').map(c => c + c).join('');
  }
  const r = parseInt(cleanHex.slice(0, 2), 16);
  const g = parseInt(cleanHex.slice(2, 4), 16);
  const b = parseInt(cleanHex.slice(4, 6), 16);
  if (isNaN(r) || isNaN(g) || isNaN(b)) {
    return '244, 63, 94';
  }
  return `${r}, ${g}, ${b}`;
};

const getValidColor = (color: string) => (color && color.trim() !== '') ? color : '#F43F5E';

const decodeHtmlEntities = (str: string) => {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#8217;/g, '’')
    .replace(/&#8216;/g, '‘');
};

const getVariationsArray = (art: any) => {
  const images = art.orderedImages || art.variationImages?.nodes;
  if (images && images.length > 0) {
    return images.map((img: any) => secureUrl(img.sourceUrl));
  }
  const featured = secureUrl(art.featuredImage?.node?.sourceUrl);
  return featured ? [featured] : [placeholderImg];
};

// クライアント側UI用データ構造に変換
const charactersData = models.map((m: any) => {
  const color = getValidColor(m.memberColor);
  const rgb = hexToRgbString(color);
  const avatar = secureUrl(m.modelAvatar?.node?.sourceUrl) || placeholderImg;
  const works = (m.artworks?.nodes || []).map((art: any) => {
    let photos: any[] = [];

    if (art.normalizedImages && Array.isArray(art.normalizedImages)) {
      photos = art.normalizedImages.map((img: any, idx: number) => ({
        id: `${art.databaseId || art.id}-${img.id || idx}`,
        title: img.title || `${art.title} #${String(idx + 1).padStart(2, '0')}`,
        image: secureUrl(img.sourceUrl) || placeholderImg,
        modelName: m.name,
        workTitle: art.title,
        contentRating: img.contentRating || 'safe',
        sortOrder: img.sortOrder,
      }));
    } else {
      const cover = secureUrl(art.featuredImage?.node?.sourceUrl) || placeholderImg;
      const variationUrls = getVariationsArray(art);
      const allImgUrls = variationUrls.length > 0 ? variationUrls : [cover];
      photos = allImgUrls.map((url: string, idx: number) => ({
        id: `${art.databaseId || art.id}-${idx}`,
        title: `${art.title} #${String(idx + 1).padStart(2, '0')}`,
        image: url,
        modelName: m.name,
        workTitle: art.title,
        contentRating: 'safe',
      }));
    }

    const cover = photos.length > 0
      ? photos[0].image
      : (secureUrl(art.featuredImage?.node?.sourceUrl) || placeholderImg);

    return {
      id: art.id,
      databaseId: art.databaseId || 0,
      title: art.title,
      slug: art.slug,
      coverImage: cover,
      photos,
      promptData: art.promptData || '',
      likeCount: art.likeCount || 0,
      guestComments: art.guestComments || [],
      hasArtworkImages: Boolean(art.hasArtworkImages),
    };
  });
  return {
    id: m.slug || m.id,
    dbId: m.id,
    name: m.name,
    bio: m.modelBio || '',
    color,
    rgb,
    avatar,
    works,
  };
});

// トップ画面用スライダーデータ
const slidesData = (sliders && sliders.length > 0 ? sliders : [{
  title: 'Welcome',
  featuredImage: { node: { sourceUrl: placeholderImg } },
  memberColor: '#F43F5E'
}]).map((s: any) => ({
  title: s.title || '',
  image: secureUrl(s.featuredImage?.node?.sourceUrl) || placeholderImg,
  color: getValidColor(s.memberColor),
  rgb: hexToRgbString(s.memberColor),
}));

const siteTitle = decodeHtmlEntities(siteInfo.title) || "Miu's Gallery | Fine Photography & Character Archive";
const siteDescription = decodeHtmlEntities(siteInfo.description) || "オリジナルキャラクターの「美羽」達の美麗な写真をお楽しみください。";
const siteUrl = Astro.site ? Astro.site.toString() : "https://xx-ai-girls-miu.com/";
const ogImageUrl = slidesData[0]?.image || placeholderImg;

const schemaLD = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": siteTitle,
  "description": siteDescription,
  "url": siteUrl,
  "image": ogImageUrl,
  "author": {
    "@type": "Person",
    "name": "Miu"
  }
};
---

<!DOCTYPE html>
<html lang="ja" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <!-- SEO & OGP -->
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteUrl} />
    
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImageUrl} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#060608" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Miu's Gallery" />
    
    <ClientRouter />

    <!-- Service Worker Registration -->
    <script>
      import { registerSW } from 'virtual:pwa-register';
      if ('serviceWorker' in navigator) {
        const updateSW = registerSW({
          immediate: true,
          onNeedRefresh() {
            updateSW(true);
          }
        });
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;800&family=Noto+Sans+JP:wght@300;400;500;700&family=Outfit:wght@200;300;400;600;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <!-- JSON-LD 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />

    <!-- OneSignal Web Push SDK -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script is:inline>
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      OneSignalDeferred.push(async function(OneSignal) {
        await OneSignal.init({
          appId: "06418ce1-102a-4a7b-a88b-069b594cf919",
          promptOptions: {
            slidedown: {
              prompts: [
                {
                  type: "push",
                  autoPrompt: true,
                  text: {
                    actionMessage: "新しいギャラリーが追加されたら通知を受け取りますか？",
                    acceptButton: "受け取る",
                    cancelButton: "あとで",
                  },
                  delay: {
                    pageViews: 1,
                    timeDelay: 5 
                  }
                }
              ]
            }
          }
        });
      });
    </script>

    <script define:vars={{ wpGraphqlUrl }}>
      window.WP_GRAPHQL_URL = wpGraphqlUrl;
    </script>
  </head>

  <body class="bg-base text-slate-100 selection:bg-rose-500 selection:text-white">
    <!-- Dynamic Ambient Background (GPU Accelerated) -->
    <div id="ambient-aura-layer" class="ambient-aura-layer" aria-hidden="true"></div>

    <!-- Interactive Custom Cursor (PC fine pointer only) -->
    <div id="custom-cursor" class="custom-cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <div class="cursor-ring"></div>
      <span class="cursor-label">EXPAND</span>
    </div>

    <!-- Floating Top Bar: Logo, Social Links & About -->
    <header class="floating-top-bar" id="floating-top-bar">
      <div class="floating-brand-group">
        <button class="floating-brand-logo" id="brand-home-link" aria-label="Miu's Gallery Home">
          <span class="brand-sym">✦</span>
          <span>Miu's <span class="brand-sub">Gallery</span></span>
        </button>

        <div class="floating-social-links">
          <!-- Instagram -->
          <a href="https://www.instagram.com/xx.ai.girls.miu0402/" target="_blank" rel="noopener noreferrer" class="social-icon-btn instagram-btn" aria-label="Instagram">
            <svg class="social-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- Patreon -->
          <a href="https://www.patreon.com/cw/u73055670?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink" target="_blank" rel="noopener noreferrer" class="social-icon-btn patreon-btn" aria-label="Patreon">
            <svg class="social-svg-icon patreon-new-logo" viewBox="0 0 1080 1080" fill="currentColor" aria-hidden="true">
              <path d="M1033.05,324.45c-0.19-137.9-107.59-250.92-233.6-291.7c-156.48-50.64-362.86-43.3-512.28,27.2 C106.07,145.41,49.18,332.61,47.06,519.31c-1.74,153.5,13.58,557.79,241.62,560.67c169.44,2.15,194.67-216.18,273.07-321.33 c55.78-74.81,127.6-95.94,216.01-117.82C929.71,603.22,1033.27,483.3,1033.05,324.45z"></path>
            </svg>
          </a>

          <!-- Info / About Button -->
          <button id="btn-open-info" class="social-icon-btn info-btn" aria-label="About Gallery">
            <svg class="social-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- APP MAIN: 100dvh VIEWPORT APP -->
    <main class="app-viewport-container">

      <!-- LEFT / TOP PANE: DYNAMIC MAIN VISUAL STAGE -->
      <section class="main-visual-stage" id="main-visual-stage" aria-label="メイン写真ビュー">
        
        <!-- Background Ambient Blur Image Layer -->
        <div class="stage-blur-layer" id="stage-blur-layer">
          <img id="stage-blur-img" src={slidesData[0]?.image} alt="" aria-hidden="true">
        </div>

        <!-- Main High-Res Photo Container (Click to expand) -->
        <div class="stage-photo-wrapper tilt-element" id="stage-photo-wrapper" data-tilt-intensity="6">
          <img id="main-stage-img" src={slidesData[0]?.image} alt="Featured Photo" class="main-stage-photo" fetchpriority="high">
          
          <!-- Expand Prompt Overlay -->
          <div class="photo-expand-prompt">
            <span class="prompt-pill">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
              <span class="pc-text">CLICK TO EXPAND</span>
              <span class="sp-text">TAP TO EXPAND</span>
            </span>
          </div>
        </div>

        <!-- Stage Title Overlay -->
        <div class="stage-title-overlay" id="stage-title-overlay">
          <h1 class="stage-clean-title" id="stage-char-name">{slidesData[0]?.title || "Miu's Gallery"}</h1>
        </div>

        <!-- Stage Slider Dots (トップ画面自動スライダー時のインジケーター) -->
        <div class="stage-slider-dots active" id="stage-slider-dots" aria-hidden="true">
          {slidesData.map((_, i) => (
            <button class={`slider-dot ${i === 0 ? 'active' : ''}`} data-slide-index={i} aria-label={`スライド ${i + 1} へ移動`}></button>
          ))}
        </div>

      </section>

      <!-- RIGHT / BOTTOM PANE: 3-TIER CONTENT & NAVIGATION PANEL -->
      <aside class="side-content-panel" id="side-content-panel" aria-label="モデル＆作品ナビゲーション">
        
        <!-- TIER 1: CHARACTERS LIST (Initial State) -->
        <div class="panel-view-section active" id="view-characters">
          <div class="panel-view-header">
            <div>
              <h2 class="panel-heading">MODELS & CHARACTERS</h2>
              <p class="panel-subtext">モデルを選択して作品アルバムへ</p>
            </div>
          </div>

          <div class="characters-grid-list" id="characters-grid-list">
            <!-- Injected by Client JS from charactersData -->
          </div>
        </div>

        <!-- TIER 2: WORKS LIST OF SELECTED MODEL -->
        <div class="panel-view-section" id="view-works">
          
          <!-- Back Navigation to Models -->
          <div class="panel-nav-bar">
            <button class="panel-back-btn" id="btn-back-to-characters" aria-label="モデル一覧に戻る">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>MODELS & CHARACTERS</span>
            </button>
          </div>

          <!-- Selected Model Header Summary Card -->
          <div class="active-model-card" id="active-model-summary">
            <div class="model-card-top">
              <div class="model-avatar-circle">
                <img id="active-model-avatar" src="" alt="Model Avatar">
              </div>
              <div class="model-text-meta">
                <h3 class="model-card-name" id="active-model-name">Model Name</h3>
              </div>
              <div class="model-works-count-pill" id="active-model-works-count">0 Works</div>
            </div>
            <div id="active-model-bio" class="text-gray-400 text-xs mt-3 leading-relaxed border-t border-white/5 pt-3 hidden font-light"></div>
          </div>

          <!-- Works / Albums List -->
          <div class="section-sub-heading">
            <span>WORKS & ALBUMS</span>
            <span class="sub-hint">作品を選択</span>
          </div>
          <div class="works-albums-list" id="works-albums-list">
            <!-- Injected by Client JS -->
          </div>

        </div>

        <!-- TIER 3: PHOTOS THUMBNAIL GRID (Inside Selected Work) -->
        <div class="panel-view-section" id="view-photos">
          
          <!-- Back Navigation to Works List -->
          <div class="panel-nav-bar">
            <button class="panel-back-btn" id="btn-back-to-works" aria-label="作品一覧に戻る">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span id="btn-back-works-label">WORKS LIST</span>
            </button>
          </div>

          <!-- Active Work Header Card with Like & Comment Buttons -->
          <div class="active-work-summary-card">
            <div class="work-summary-top">
              <h3 class="work-summary-title" id="active-work-title">Work Title</h3>
              <div class="work-action-group">
                <!-- Like Button -->
                <button id="work-like-btn" class="action-pill-btn" aria-label="いいね">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                  </svg>
                  <span id="work-like-count">0</span>
                </button>

                <!-- Comment Button -->
                <button id="work-comment-btn" class="action-pill-btn" aria-label="コメントを見る">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span id="work-comment-count">0</span>
                </button>

                <div class="work-photos-count-badge" id="active-work-photos-count">0 Photos</div>
              </div>
            </div>
          </div>

          <!-- Thumbnails Grid inside the Work -->
          <div class="section-sub-heading">
            <span>PHOTOS IN WORK</span>
            <span class="sub-hint">タップで大画面切替</span>
          </div>
          <div class="photos-thumbnails-grid" id="photos-thumbnails-grid">
            <!-- Injected by Client JS -->
          </div>

          <!-- Patreon Banner in Detail -->
          <div class="mt-8 mb-4 p-5 bg-gradient-to-br from-rose-500/10 to-rose-500/5 border border-rose-500/20 rounded-2xl flex flex-col items-center justify-center text-center gap-3 relative overflow-hidden group">
            <p class="text-white/90 font-light text-xs sm:text-sm tracking-wide relative z-10">もっと高解像度・限定写真が見たい方は<br/>Patreonをチェックしてね❤</p>
            <a href="https://www.patreon.com/cw/u73055670?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink" target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-2 bg-rose-500 hover:bg-rose-600 text-white px-5 py-2 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 shadow-[0_4px_16px_rgba(244,63,94,0.4)]">
              <span>View on Patreon</span>
              <span>→</span>
            </a>
          </div>

        </div>

      </aside>

    </main>

    <!-- FLOATING CHARACTER SWITCHER DOCK (Tier 2 & 3) -->
    <nav id="character-floating-dock" class="character-floating-dock" aria-label="クイック・キャラクター切り替え">
      <div class="dock-inner" id="dock-inner">
        <!-- Injected by Client JS -->
      </div>
    </nav>

    <!-- CINEMATIC FULLSCREEN LIGHTBOX MODAL -->
    <dialog id="cinematic-modal" class="cinematic-lightbox" aria-modal="true" aria-label="高精細写真全画面ビュー">
      <div class="modal-backdrop-blur" id="modal-backdrop-blur"></div>
      <div class="modal-content-shell">
        
        <!-- Top Utility Bar -->
        <div class="modal-top-bar">
          <div class="modal-photo-meta">
            <span class="modal-cat-badge" id="modal-cat-badge">PHOTO</span>
            <h2 class="modal-photo-title" id="modal-photo-title">Title</h2>
            <span class="modal-photo-model" id="modal-photo-model">Model</span>
          </div>

          <div class="modal-actions">
            <!-- Modal Like Button -->
            <button id="modal-like-btn" class="modal-btn" aria-label="いいね">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
              </svg>
            </button>
            <!-- Modal Comment Button -->
            <button id="modal-comment-btn" class="modal-btn" aria-label="コメント">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </button>
            <button id="modal-prev-btn" class="modal-btn" aria-label="前の写真 (←)">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button id="modal-next-btn" class="modal-btn" aria-label="次の写真 (→)">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
            <button id="modal-close-btn" class="modal-btn close-btn" aria-label="閉じる (Esc)">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Main Photo Display Area -->
        <div class="modal-main-stage" id="modal-main-stage">
          <div class="modal-image-holder" id="modal-image-holder">
            <img id="modal-img" src="" alt="Expanded Photography" class="modal-highres-img">
          </div>

          <!-- Swipe Hint Overlay -->
          <div id="modal-swipe-hint" class="modal-swipe-hint" style="display: none;">
            <div class="swipe-hint-pill">
              <span class="swipe-arrow swipe-arrow-left">‹</span>
              <span class="swipe-hand-icon">👆</span>
              <span class="swipe-arrow swipe-arrow-right">›</span>
              <span class="swipe-hint-text">スワイプで写真送り</span>
            </div>
          </div>
        </div>

      </div>
    </dialog>

    <!-- COMMENTS MODAL / DRAWER -->
    <dialog id="comment-modal" aria-labelledby="comment-modal-title" class="bg-transparent m-auto p-0 w-full h-full max-w-md backdrop:bg-black/80 overflow-hidden outline-none z-[300] overscroll-contain">
      <div class="bg-[#121218] rounded-3xl border border-white/10 shadow-2xl flex flex-col h-[82vh] max-h-[720px] w-[92%] max-w-sm mx-auto mt-[9vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="comment-modal-content">
        <div class="p-4 px-6 border-b border-white/5 flex justify-between items-center bg-[#09090d] shrink-0">
          <h3 id="comment-modal-title" class="text-white font-medium text-sm tracking-wide">Comments <span class="text-gray-500 text-xs ml-2" id="modal-comment-count">0</span></h3>
          <button id="btn-close-comment-modal" class="text-gray-400 hover:text-white outline-none transition-colors p-1" aria-label="閉じる">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
