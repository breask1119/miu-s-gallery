<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{siteTitle}</title>
  <meta name="description" content={siteDescription}>
  <link rel="canonical" href={siteUrl}>

  <!-- OGP & Twitter Cards -->
  <meta property="og:site_name" content={siteTitle}>
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={siteDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:image" content={ogImageUrl}>
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={siteDescription}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- PWA & Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#060608">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Miu's Gallery">

  <!-- Fonts (Zen Kaku Gothic New + Outfit + Cinzel + Plus Jakarta Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Noto+Sans+JP:wght@200;300;400;500&family=Outfit:wght@200;300;400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  
  <!-- GSAP CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  <ClientRouter />

  <!-- PWA Service Worker Registration -->
  <script>
    import { registerSW } from 'virtual:pwa-register';
    if ('serviceWorker' in navigator) {
      const updateSW = registerSW({
        immediate: true,
        onNeedRefresh() {
          updateSW(true);
        }
      });
    }
  </script>

  <!-- OneSignal -->
  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  <script is:inline>
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    OneSignalDeferred.push(async function(OneSignal) {
      await OneSignal.init({
        appId: "06418ce1-102a-4a7b-a88b-069b594cf919",
        promptOptions: {
          slidedown: {
            prompts: [
              {
                type: "push",
                autoPrompt: true,
                text: {
                  actionMessage: "新しいギャラリーが追加されたら通知を受け取りますか？",
                  acceptButton: "受け取る",
                  cancelButton: "あとで",
                },
                delay: {
                  pageViews: 1,
                  timeDelay: 5 
                }
              }
            ]
          }
        }
      });
    });
  </script>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />

  <script define:vars={{ wpGraphqlUrl }}>
    window.WP_GRAPHQL_URL = wpGraphqlUrl;
  </script>
</head>
<body class="bg-base text-slate-100 selection:bg-rose-500 selection:text-white">

