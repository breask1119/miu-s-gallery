    <!-- ABOUT / INFO MODAL -->
    <dialog id="info-modal" class="info-drawer-modal" aria-modal="true" aria-label="Miu's Gallery について">
      <div class="info-drawer-inner">
        <div class="drawer-header">
          <h2 class="drawer-title">ABOUT MIU'S GALLERY</h2>
          <button id="info-close-btn" class="modal-btn" aria-label="閉じる">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="drawer-body">
          <p class="lead-statement">
            「各キャラクターの作品世界」と「写真集をめくるようなシームレスな探索」。
          </p>
          <p>
            Miu's Gallery は、オリジナルAIキャラクター「美羽」達の美麗な写真と世界観を、1画面内でスムーズに鑑賞できる次世代フォトギャラリーです。
          </p>
          <h3>HOW TO EXPLORE</h3>
          <ul class="guide-list">
            <li><strong>モデル選択:</strong> モデル一覧から気になるモデルをタップすると、そのモデルの作品集（Works）が展開。</li>
            <li><strong>作品選択:</strong> 作品を選ぶと、収録写真のサムネイル一覧が表示され、大画面で鑑賞できます。</li>
            <li><strong>写真送り:</strong> 左右矢印ボタンや、スマホの画面スワイプで同じ作品内の写真を連続してめくれます。</li>
            <li><strong>全画面拡大:</strong> メイン写真をタップすると、高精細ズームモーダルが起動。</li>
            <li><strong>キーボード操作:</strong> <kbd>Esc</kbd> で1階層戻る / モーダルを閉じる、<kbd>←</kbd> <kbd>→</kbd> で写真送り。</li>
            <li><strong>ダブルタップ:</strong> 作品詳細時やモーダル内でのダブルタップでハートのいいね！が送れます。</li>
          </ul>
        </div>
      </div>
    </dialog>

    <!-- Client-side Application Script -->
    <script define:vars={{ charactersData, slidesData }}>
      // クライアントサイドの状態管理
      window.__CHARACTERS_DATA__ = charactersData;
      window.__SLIDES_DATA__ = slidesData;
    </script>

    <script is:inline>
      (function() {
        const characters = window.__CHARACTERS_DATA__ || [];
        const slides = window.__SLIDES_DATA__ || [];

        let currentModelId = characters[0]?.id || '';
        let currentWork = null;
        let currentPhotosInWork = [];
        let currentPhotoIndex = 0;
        let currentAllPhotosFlat = [];

        // 全写真フラット配列の作成（全画面モーダル用）
        characters.forEach(c => {
          c.works.forEach(w => {
            w.photos.forEach(p => currentAllPhotosFlat.push(p));
          });
        });

        // ヒーロースライダー状態
        let isHeroSliderActive = true;
        let heroSliderTimer = null;
        let heroCurrentIndex = 0;

        // モーダル状態
        let modalFilteredList = currentAllPhotosFlat;
        let modalCurrentIndex = 0;
        let currentScale = 1;
        let currentPanX = 0;
        let currentPanY = 0;
        let isPinching = false;
        let isPanning = false;
        let startPinchDist = 0;
        let startScale = 1;
        let touchStartX = 0;
        let touchStartY = 0;
        let startPanX = 0;
        let startPanY = 0;
        let lastTapTime = 0;

        // コメント返信状態
        let activeReplyId = 0;

        // --- DOM Elements ---
        const stageImg = document.getElementById('main-stage-img');
        const stageBlurImg = document.getElementById('stage-blur-img');
        const stageTitle = document.getElementById('stage-char-name');
        const stageDots = document.getElementById('stage-slider-dots');
        const floatingDock = document.getElementById('character-floating-dock');
        const dockInner = document.getElementById('dock-inner');
        const sidePanel = document.getElementById('side-content-panel');

        const viewChars = document.getElementById('view-characters');
        const viewWorks = document.getElementById('view-works');
        const viewPhotos = document.getElementById('view-photos');

        const cinematicModal = document.getElementById('cinematic-modal');
        const modalImg = document.getElementById('modal-img');
        const modalTitle = document.getElementById('modal-photo-title');
        const modalModel = document.getElementById('modal-photo-model');
        const modalBadge = document.getElementById('modal-cat-badge');
        const imageHolder = document.getElementById('modal-image-holder');
        const modalSwipeHint = document.getElementById('modal-swipe-hint');

        const commentModal = document.getElementById('comment-modal');
        const commentModalContent = document.getElementById('comment-modal-content');
        const commentList = document.getElementById('comment-list');
        const commentAuthorInput = document.getElementById('comment-author');
        const commentContentInput = document.getElementById('comment-content');
        const commentSubmitBtn = document.getElementById('comment-submit-btn');

        const infoModal = document.getElementById('info-modal');

        // ============================================================
        // 1. DYNAMIC COLOR MORPHING
        // ============================================================
        function morphColor(hex, rgb) {
          const root = document.documentElement;
          root.style.setProperty('--char-accent', hex);
          root.style.setProperty('--char-rgb', rgb);
          root.style.setProperty('--char-glow', `rgba(${rgb}, 0.35)`);
        }

        // ============================================================
        // 2. HERO SLIDER
        // ============================================================
        function startHeroSlider() {
          isHeroSliderActive = true;
          document.body.classList.remove('is-subpage', 'is-photos-view');
          if (stageDots) stageDots.classList.add('active');
          if (floatingDock) floatingDock.classList.remove('visible');
          if (sidePanel) sidePanel.classList.remove('has-floating-dock');

          if (heroSliderTimer) clearInterval(heroSliderTimer);
          updateHeroSlide(heroCurrentIndex);

          if (slides.length > 1) {
            heroSliderTimer = setInterval(() => {
              if (!isHeroSliderActive) return;
              heroCurrentIndex = (heroCurrentIndex + 1) % slides.length;
              updateHeroSlide(heroCurrentIndex);
            }, 4500);
          }
        }

        function stopHeroSlider() {
          isHeroSliderActive = false;
          if (heroSliderTimer) clearInterval(heroSliderTimer);
          if (stageDots) stageDots.classList.remove('active');
        }

        function updateHeroSlide(index) {
          const slide = slides[index];
          if (!slide) return;
          if (stageImg) stageImg.src = slide.image;
          if (stageBlurImg) stageBlurImg.src = slide.image;
          if (stageTitle) stageTitle.textContent = slide.title || "Miu's Gallery";
          morphColor(slide.color, slide.rgb);

          // Update dots
          const dots = document.querySelectorAll('.slider-dot');
          dots.forEach((dot, idx) => {
            if (idx === index) dot.classList.add('active');
            else dot.classList.remove('active');
          });
        }

        // ============================================================
        // 3. 3-TIER NAVIGATION & RENDERING
        // ============================================================
        function switchPanelView(viewId) {
          [viewChars, viewWorks, viewPhotos].forEach(view => {
            if (!view) return;
            if (view.id === viewId) {
              view.classList.add('active');
              view.scrollTop = 0;
            } else {
              view.classList.remove('active');
            }
          });

          const isSubpage = (viewId === 'view-works' || viewId === 'view-photos');
          const isPhotosView = (viewId === 'view-photos');

          document.body.classList.toggle('is-subpage', isSubpage);
          document.body.classList.toggle('is-photos-view', isPhotosView);

          if (floatingDock) floatingDock.classList.toggle('visible', isSubpage);
          if (sidePanel) sidePanel.classList.toggle('has-floating-dock', isSubpage);
        }

        // TIER 1: CHARACTERS VIEW
        function renderCharactersView() {
          const container = document.getElementById('characters-grid-list');
          if (!container) return;

          container.innerHTML = characters.map(c => `
            <button class="char-select-card" data-char-id="${c.id}" aria-label="${c.name} の作品アルバムを見る">
              <div class="char-card-media">
                <img src="${c.avatar}" alt="${c.name}" loading="lazy">
                <div class="char-card-color-overlay" style="background-color: ${c.color};"></div>
              </div>
              <div class="char-card-caption">
                <div class="char-card-name">${c.name}</div>
                <div class="char-card-works-count">${c.works.length} Works</div>
              </div>
            </button>
          `).join('');

          container.querySelectorAll('.char-select-card').forEach(card => {
            card.addEventListener('click', () => {
              const cid = card.getAttribute('data-char-id');
              showWorksView(cid);
            });
          });
        }

        function showCharactersView() {
          switchPanelView('view-characters');
          startHeroSlider();
        }

        // TIER 2: WORKS VIEW OF SELECTED MODEL
        function showWorksView(modelId) {
          stopHeroSlider();
          currentModelId = modelId;
          const model = characters.find(c => c.id === modelId) || characters[0];
          if (!model) return;

          morphColor(model.color, model.rgb);
          switchPanelView('view-works');
          updateFloatingDockActive(modelId);

          // Header summary
          const avatar = document.getElementById('active-model-avatar');
          const name = document.getElementById('active-model-name');
          const count = document.getElementById('active-model-works-count');
          const bio = document.getElementById('active-model-bio');
          if (avatar) avatar.src = model.avatar;
          if (name) name.textContent = model.name;
          if (count) count.textContent = `${model.works.length} Works`;
          if (bio) {
            if (model.bio) {
              bio.innerHTML = model.bio;
              bio.classList.remove('hidden');
            } else {
              bio.classList.add('hidden');
            }
          }

          // Main stage display: Model's first artwork cover
          const firstWork = model.works[0];
          const displayImg = firstWork ? firstWork.coverImage : model.avatar;
          if (stageImg) stageImg.src = displayImg;
          if (stageBlurImg) stageBlurImg.src = displayImg;
          if (stageTitle) stageTitle.textContent = model.name;

          // Render Works List (Matches style.css .work-album-card)
          const worksContainer = document.getElementById('works-albums-list');
          if (worksContainer) {
            worksContainer.innerHTML = model.works.map(w => `
              <button class="work-album-card" data-work-id="${w.id}" aria-label="${w.title} の写真を閲覧">
                <div class="work-album-cover">
                  <img src="${w.coverImage}" alt="${w.title}" loading="lazy">
                </div>
                <div class="work-album-info">
                  <h4 class="work-album-title">${w.title}</h4>
                  <div class="work-album-meta">
                    <span class="work-photos-badge">${w.photos.length} Photos</span>
                  </div>
                </div>
              </button>
            `).join('');

            worksContainer.querySelectorAll('.work-album-card').forEach(card => {
              card.addEventListener('click', () => {
                const wid = card.getAttribute('data-work-id');
                showPhotosView(wid);
              });
            });
          }
        }

        // TIER 3: PHOTOS IN SELECTED WORK
        function showPhotosView(workId) {
          stopHeroSlider();
          const model = characters.find(c => c.id === currentModelId) || characters[0];
          const work = model?.works.find(w => w.id === workId) || model?.works[0];
          if (!work) return;

          currentWork = work;
          currentPhotosInWork = work.photos || [];
          currentPhotoIndex = 0;

          switchPanelView('view-photos');
          updateFloatingDockActive(currentModelId);

          // Work header card
          const title = document.getElementById('active-work-title');
          const count = document.getElementById('active-work-photos-count');
          const backLabel = document.getElementById('btn-back-works-label');
          if (title) title.textContent = work.title;
          if (count) count.textContent = `${currentPhotosInWork.length} Photos`;
          if (backLabel) backLabel.textContent = `${model.name.split(' ')[0]} WORKS`;

          // Like & Comments state
          updateWorkStatsUI();
          fetchLiveStats(work.databaseId);

          // Main stage photo
          updateStagePhoto(0);

          // Render photos thumbnails grid (Matches style.css .photo-thumb-btn)
          const grid = document.getElementById('photos-thumbnails-grid');
          if (grid) {
            grid.innerHTML = currentPhotosInWork.map((p, idx) => `
              <button class="photo-thumb-btn ${idx === 0 ? 'active' : ''}" data-index="${idx}" aria-label="${p.title}">
                <img src="${p.image}" alt="${p.title}" loading="lazy">
                <div class="photo-thumb-caption">${p.title}</div>
              </button>
            `).join('');

            grid.querySelectorAll('.photo-thumb-btn').forEach(btn => {
              btn.addEventListener('click', () => {
                const idx = parseInt(btn.getAttribute('data-index'), 10);
                currentPhotoIndex = idx;
                updateStagePhoto(idx);
              });
            });
          }
        }

        function updateStagePhoto(index) {
          const photo = currentPhotosInWork[index];
          if (!photo) return;

          currentPhotoIndex = index;
          if (stageImg) stageImg.src = photo.image;
          if (stageBlurImg) stageBlurImg.src = photo.image;
          if (stageTitle) stageTitle.textContent = photo.workTitle || photo.title;

          // Highlight thumb
          document.querySelectorAll('.photo-thumb-btn').forEach((btn, idx) => {
            btn.classList.toggle('active', idx === index);
          });
        }

        // ============================================================
        // 4. FLOATING QUICK-SWITCHER DOCK
        // ============================================================
        function initFloatingDock() {
          if (!dockInner) return;
          dockInner.innerHTML = characters.map(c => `
            <button class="dock-item-btn ${c.id === currentModelId ? 'active' : ''}" data-char-id="${c.id}" aria-label="${c.name} の作品へ切り替え">
              <img src="${c.avatar}" alt="${c.name}" class="dock-avatar-img">
              <div class="dock-active-indicator" style="background: ${c.color};"></div>
              <div class="dock-tooltip">
                <span class="dock-tooltip-dot" style="background: ${c.color};"></span>
                <span>${c.name}</span>
              </div>
            </button>
          `).join('');

          dockInner.querySelectorAll('.dock-item-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const cid = btn.getAttribute('data-char-id');
              showWorksView(cid);
            });
          });
        }

        function updateFloatingDockActive(modelId) {
          document.querySelectorAll('.dock-item-btn').forEach(btn => {
            const isActive = btn.getAttribute('data-char-id') === modelId;
            btn.classList.toggle('active', isActive);
          });
        }

        // ============================================================
        // 5. CINEMATIC FULLSCREEN LIGHTBOX MODAL
        // ============================================================
        function openModal(photoId) {
          modalFilteredList = currentPhotosInWork.length > 0 ? currentPhotosInWork : currentAllPhotosFlat;
          const foundIdx = modalFilteredList.findIndex(p => p.id === photoId);
          modalCurrentIndex = foundIdx !== -1 ? foundIdx : 0;

          resetZoom();
          renderModalContent();
          cinematicModal?.showModal();

          if (!localStorage.getItem('miu_swipe_hint_seen')) {
            if (modalSwipeHint) modalSwipeHint.style.display = 'flex';
          }
        }

        function closeModal() {
          resetZoom();
          if (modalSwipeHint) modalSwipeHint.style.display = 'none';
          cinematicModal?.close();
        }

        function modalNext() {
          resetZoom();
          modalCurrentIndex = (modalCurrentIndex + 1) % modalFilteredList.length;
          renderModalContent();
        }

        function modalPrev() {
          resetZoom();
          modalCurrentIndex = (modalCurrentIndex - 1 + modalFilteredList.length) % modalFilteredList.length;
          renderModalContent();
        }

        function renderModalContent() {
          const photo = modalFilteredList[modalCurrentIndex];
          if (!photo) return;

          if (modalImg) {
            modalImg.style.opacity = '0';
            modalImg.style.transform = 'scale(0.96)';
            setTimeout(() => {
              modalImg.src = photo.image;
              modalImg.onload = () => {
                modalImg.style.opacity = '1';
                modalImg.style.transform = 'scale(1)';
              };
            }, 100);
          }

          if (modalTitle) modalTitle.textContent = photo.workTitle || photo.title;
          if (modalModel) modalModel.textContent = photo.modelName || '';
          if (modalBadge) modalBadge.textContent = `#${modalCurrentIndex + 1} / ${modalFilteredList.length}`;

          updateModalLikeButton();
        }

        function resetZoom() {
          currentScale = 1;
          currentPanX = 0;
          currentPanY = 0;
          if (imageHolder) {
            imageHolder.style.transform = 'translate3d(0, 0, 0) scale(1)';
          }
        }

        // Modal Gestures (Pinch zoom, double tap, swipe)
        function initModalGestures() {
          const stage = document.getElementById('modal-main-stage');
          if (!stage) return;

          stage.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
              isPinching = true;
              isPanning = false;
              startPinchDist = Math.hypot(
                e.touches[0].clientX - e.touches[1].clientX,
                e.touches[0].clientY - e.touches[1].clientY
              );
              startScale = currentScale;
            } else if (e.touches.length === 1) {
              isPinching = false;
              touchStartX = e.touches[0].clientX;
              touchStartY = e.touches[0].clientY;
              startPanX = currentPanX;
              startPanY = currentPanY;
              if (currentScale > 1.05) isPanning = true;

              // Double tap check
              const now = Date.now();
              if (now - lastTapTime < 300) {
                if (currentScale > 1.1) {
                  resetZoom();
                } else {
                  currentScale = 2.4;
                  if (imageHolder) imageHolder.style.transform = `translate3d(0, 0, 0) scale(${currentScale})`;
                }
                triggerLikeAnimation(e);
              }
              lastTapTime = now;
            }
          }, { passive: true });

          stage.addEventListener('touchmove', (e) => {
            if (isPinching && e.touches.length === 2) {
              const dist = Math.hypot(
                e.touches[0].clientX - e.touches[1].clientX,
                e.touches[0].clientY - e.touches[1].clientY
              );
              currentScale = Math.min(Math.max(startScale * (dist / startPinchDist), 0.9), 4.5);
              if (imageHolder) imageHolder.style.transform = `translate3d(${currentPanX}px, ${currentPanY}px, 0) scale(${currentScale})`;
            } else if (isPanning && e.touches.length === 1) {
              const deltaX = e.touches[0].clientX - touchStartX;
              const deltaY = e.touches[0].clientY - touchStartY;
              currentPanX = startPanX + deltaX;
              currentPanY = startPanY + deltaY;
              if (imageHolder) imageHolder.style.transform = `translate3d(${currentPanX}px, ${currentPanY}px, 0) scale(${currentScale})`;
            }
          }, { passive: true });

          stage.addEventListener('touchend', (e) => {
            if (isPinching && e.touches.length < 2) isPinching = false;
            if (isPanning && e.touches.length === 0) isPanning = false;

            if (currentScale < 1.05) {
              resetZoom();
              // Swipe navigation
              if (e.changedTouches.length > 0) {
                const deltaX = e.changedTouches[0].clientX - touchStartX;
                const deltaY = e.changedTouches[0].clientY - touchStartY;
                if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4) {
                  if (deltaX < 0) modalNext();
                  else modalPrev();
                }
              }
            }
          }, { passive: true });

          modalSwipeHint?.addEventListener('click', () => {
            modalSwipeHint.style.display = 'none';
            localStorage.setItem('miu_swipe_hint_seen', 'true');
          });
        }

        // ============================================================
        // 6. LIKES & COMMENTS (PRESERVE EXACT LOGIC)
        // ============================================================
        function isPostLiked(dbId) {
          if (!dbId) return false;
          const liked = JSON.parse(localStorage.getItem('miu_liked_posts') || '[]');
          return liked.includes(dbId.toString());
        }

        function markPostAsLiked(dbId) {
          if (!dbId) return;
          const liked = JSON.parse(localStorage.getItem('miu_liked_posts') || '[]');
          if (!liked.includes(dbId.toString())) {
            liked.push(dbId.toString());
            localStorage.setItem('miu_liked_posts', JSON.stringify(liked));
          }
        }

        function triggerLikeAnimation(e) {
          if (!currentWork || !currentWork.databaseId) return;
          const dbId = currentWork.databaseId;
          if (isPostLiked(dbId)) return;

          markPostAsLiked(dbId);
          currentWork.likeCount++;
          updateWorkStatsUI();

          // Heart burst animation
          const heart = document.createElement('div');
          heart.className = 'fixed pointer-events-none z-[99999] transform -translate-x-1/2 -translate-y-1/2 animate-heart-burst';
          heart.innerHTML = `<svg viewBox="0 0 24 24" class="w-28 h-28 fill-current text-rose-500 drop-shadow-[0_0_30px_rgba(244,63,94,0.8)]"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
          heart.style.left = (e?.clientX || window.innerWidth / 2) + 'px';
          heart.style.top = (e?.clientY || window.innerHeight / 2) + 'px';
          document.body.appendChild(heart);
          setTimeout(() => heart.remove(), 1000);

          if (window.WP_GRAPHQL_URL) {
            fetch(window.WP_GRAPHQL_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                query: `mutation IncrementLike($postId: Int!) { incrementLike(input: {postId: $postId}) { newCount } }`,
                variables: { postId: parseInt(dbId) }
              })
            }).catch(err => console.error('Like request failed', err));
          }
        }

        function updateWorkStatsUI() {
          if (!currentWork) return;
          const likeCountEl = document.getElementById('work-like-count');
          const commentCountEl = document.getElementById('work-comment-count');
          const workLikeBtn = document.getElementById('work-like-btn');
          const isLiked = isPostLiked(currentWork.databaseId);

          if (likeCountEl) likeCountEl.textContent = (currentWork.likeCount || 0).toLocaleString();
          if (commentCountEl) commentCountEl.textContent = (currentWork.guestComments?.length || 0).toString();
          if (workLikeBtn) {
            if (isLiked) workLikeBtn.classList.add('is-liked');
            else workLikeBtn.classList.remove('is-liked');
          }
          updateModalLikeButton();
        }

        function updateModalLikeButton() {
          const modalLikeBtn = document.getElementById('modal-like-btn');
          if (!modalLikeBtn || !currentWork) return;
          const isLiked = isPostLiked(currentWork.databaseId);
          if (isLiked) {
            modalLikeBtn.classList.add('text-rose-500', 'fill-current');
            modalLikeBtn.style.color = 'var(--char-accent)';
          } else {
            modalLikeBtn.classList.remove('text-rose-500', 'fill-current');
            modalLikeBtn.style.color = '';
          }
        }

        function fetchLiveStats(postId) {
          if (!window.WP_GRAPHQL_URL || !postId) return;
          fetch(window.WP_GRAPHQL_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query: `query GetLiveStats($postId: Int!) { liveArtworkStats(postId: $postId) { likeCount guestComments { id parentId author content date } } }`,
              variables: { postId: parseInt(postId) }
            })
          })
          .then(res => res.json())
          .then(res => {
            const stats = res?.data?.liveArtworkStats;
            if (stats && currentWork && currentWork.databaseId == postId) {
              currentWork.likeCount = stats.likeCount || 0;
              currentWork.guestComments = stats.guestComments || [];
              updateWorkStatsUI();
              renderComments();
            }
          })
          .catch(err => console.error(err));
        }

        function renderComments() {
          if (!commentList || !currentWork) return;
          const comments = currentWork.guestComments || [];
          const modalCount = document.getElementById('modal-comment-count');
          if (modalCount) modalCount.textContent = comments.length;

          if (comments.length === 0) {
            commentList.innerHTML = '<p class="text-gray-500 font-light text-center py-10">まだコメントはありません。<br/>最初のコメントを投稿しよう！</p>';
            return;
          }

          const topComments = comments.filter(c => !c.parentId || c.parentId === 0);
          commentList.innerHTML = topComments.map(c => {
            const replies = comments.filter(r => r.parentId === c.id);
            return `
              <div class="bg-white/5 border border-white/5 rounded-2xl p-3 text-xs">
                <div class="flex items-baseline justify-between mb-1.5">
                  <span class="text-white font-medium">${c.author || '名無しさん'}</span>
                  <span class="text-gray-500 text-[10px]">${c.date ? new Date(c.date).toLocaleDateString() : 'Just now'}</span>
                </div>
                <p class="text-gray-300 font-light leading-relaxed mb-2">${c.content}</p>
                <button class="btn-reply text-[10px] text-gray-500 hover:text-rose-400 flex items-center gap-1 outline-none" data-reply-id="${c.id}" data-reply-author="${c.author || '名無しさん'}">
                  <span>↩ 返信する</span>
                </button>
                ${replies.length > 0 ? `
                  <div class="space-y-2 mt-2 ml-4 border-l-2 border-rose-500/40 pl-2">
                    ${replies.map(r => `
                      <div class="bg-white/5 rounded-xl p-2">
                        <div class="flex items-baseline justify-between mb-1">
                          <span class="text-white font-medium text-[11px]">${r.author || '名無しさん'}</span>
                          <span class="text-gray-500 text-[9px]">${r.date ? new Date(r.date).toLocaleDateString() : 'Just now'}</span>
                        </div>
                        <p class="text-gray-300 font-light leading-relaxed">${r.content}</p>
                      </div>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

          commentList.querySelectorAll('.btn-reply').forEach(btn => {
            btn.addEventListener('click', () => {
              activeReplyId = parseInt(btn.getAttribute('data-reply-id'));
              const name = btn.getAttribute('data-reply-author');
              const indicator = document.getElementById('reply-indicator');
              const nameSpan = document.getElementById('reply-indicator-name');
              if (indicator && nameSpan) {
                nameSpan.textContent = name;
                indicator.classList.remove('hidden');
                indicator.classList.add('flex');
              }
              commentContentInput?.focus();
            });
          });
        }

        function cancelReply() {
          activeReplyId = 0;
          const indicator = document.getElementById('reply-indicator');
          if (indicator) {
            indicator.classList.add('hidden');
            indicator.classList.remove('flex');
          }
        }

        function openCommentModal() {
          renderComments();
          if (commentModal && commentModalContent) {
            commentModal.showModal();
            setTimeout(() => {
              commentModalContent.style.transform = 'scale(1)';
              commentModalContent.style.opacity = '1';
            }, 10);
            commentModal.onclick = (e) => {
              if (e.target === commentModal) closeCommentModal();
            };
          }
        }

        function closeCommentModal() {
          if (commentModal && commentModalContent) {
            commentModalContent.style.transform = 'scale(0.95)';
            commentModalContent.style.opacity = '0';
            setTimeout(() => {
              commentModal.close();
              cancelReply();
            }, 250);
          }
        }

        function submitComment() {
          if (!currentWork || !currentWork.databaseId) {
            alert("エラー：作品が選択されていません。");
            return;
          }
          const author = (commentAuthorInput?.value || '').trim() || '名無しさん';
          const content = (commentContentInput?.value || '').trim();

          if (!content) {
            alert("コメントを入力してください！");
            return;
          }

          if (commentSubmitBtn) {
            commentSubmitBtn.disabled = true;
            commentSubmitBtn.textContent = '送信中...';
          }

          if (window.WP_GRAPHQL_URL) {
            fetch(window.WP_GRAPHQL_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                query: `mutation SubmitComment($postId: Int!, $author: String!, $content: String!, $parentId: Int) { submitGuestComment(input: {postId: $postId, author: $author, content: $content, parentId: $parentId}) { success message } }`,
                variables: {
                  postId: parseInt(currentWork.databaseId),
                  author,
                  content,
                  parentId: activeReplyId || 0
                }
              })
            })
            .then(res => res.json())
            .then(data => {
              if (data?.data?.submitGuestComment?.success) {
                if (commentContentInput) commentContentInput.value = '';
                cancelReply();
                fetchLiveStats(currentWork.databaseId);
                setTimeout(() => {
                  if (commentList) commentList.scrollTop = commentList.scrollHeight;
                }, 300);
              } else {
                const errMsg = data?.data?.submitGuestComment?.message || data?.errors?.[0]?.message || 'サーバー側で拒否されました';
                alert('送信に失敗しました: ' + errMsg);
              }
            })
            .catch(err => {
              console.error('Comment error:', err);
              alert('通信エラーが発生しました。');
            })
            .finally(() => {
              if (commentSubmitBtn) {
                commentSubmitBtn.disabled = false;
                commentSubmitBtn.textContent = '送信';
              }
            });
          }
        }

        // ============================================================
        // 7. MOTION & INTERACTION (CURSOR & 3D TILT)
        // ============================================================
        function initCursor() {
          const cursor = document.getElementById('custom-cursor');
          if (!cursor) return;

          let mouseX = window.innerWidth / 2;
          let mouseY = window.innerHeight / 2;
          let cursorX = mouseX;
          let cursorY = mouseY;

          window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
          }, { passive: true });

          function animate() {
            cursorX += (mouseX - cursorX) * 0.25;
            cursorY += (mouseY - cursorY) * 0.25;
            cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0)`;
            requestAnimationFrame(animate);
          }
          requestAnimationFrame(animate);

          document.addEventListener('mouseover', (e) => {
            const target = e.target.closest('button, a, .char-select-card, .work-album-card, .photo-thumb-btn, .dock-item-btn');
            if (target) cursor.classList.add('cursor-hover');
            else cursor.classList.remove('cursor-hover');
          });
        }

        function init3DTilt() {
          const tiltEl = document.getElementById('stage-photo-wrapper');
          if (!tiltEl) return;
          const intensity = 6;

          tiltEl.addEventListener('mousemove', (e) => {
            const rect = tiltEl.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -intensity;
            const rotateY = ((x - centerX) / centerX) * intensity;
            tiltEl.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(1)}deg) rotateY(${rotateY.toFixed(1)}deg) scale3d(1.01, 1.01, 1.01)`;
          }, { passive: true });

          tiltEl.addEventListener('mouseleave', () => {
            tiltEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
          }, { passive: true });
        }

        // ============================================================
        // 8. EVENT BINDINGS & INITIALIZATION
        // ============================================================
        function setupEventListeners() {
          // Home brand click
          document.getElementById('brand-home-link')?.addEventListener('click', (e) => {
            e.preventDefault();
            showCharactersView();
          });

          // Back buttons
          document.getElementById('btn-back-to-characters')?.addEventListener('click', showCharactersView);
          document.getElementById('btn-back-to-works')?.addEventListener('click', () => showWorksView(currentModelId));

          // Main stage photo click -> Lightbox Modal
          document.getElementById('stage-photo-wrapper')?.addEventListener('click', (e) => {
            if (isHeroSliderActive || !document.body.classList.contains('is-subpage')) return;
            const activePhoto = currentPhotosInWork[currentPhotoIndex];
            if (activePhoto) openModal(activePhoto.id);
          });

          // Slider dots click
          document.querySelectorAll('.slider-dot').forEach(dot => {
            dot.addEventListener('click', () => {
              const idx = parseInt(dot.getAttribute('data-slide-index'));
              heroCurrentIndex = idx;
              updateHeroSlide(idx);
            });
          });

          // Modal Controls
          document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
          document.getElementById('modal-backdrop-blur')?.addEventListener('click', closeModal);
          document.getElementById('modal-next-btn')?.addEventListener('click', modalNext);
          document.getElementById('modal-prev-btn')?.addEventListener('click', modalPrev);

          // Modal Actions
          document.getElementById('modal-like-btn')?.addEventListener('click', (e) => triggerLikeAnimation(e));
          document.getElementById('modal-comment-btn')?.addEventListener('click', openCommentModal);

          // Work Header Actions
          document.getElementById('work-like-btn')?.addEventListener('click', (e) => triggerLikeAnimation(e));
          document.getElementById('work-comment-btn')?.addEventListener('click', openCommentModal);

          // Comments Modal Controls
          document.getElementById('btn-close-comment-modal')?.addEventListener('click', closeCommentModal);
          document.getElementById('btn-cancel-reply')?.addEventListener('click', cancelReply);
          document.getElementById('comment-submit-btn')?.addEventListener('click', submitComment);
          commentContentInput?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') submitComment();
          });

          // Info Modal Controls
          document.getElementById('btn-open-info')?.addEventListener('click', () => infoModal?.showModal());
          document.getElementById('info-close-btn')?.addEventListener('click', () => infoModal?.close());
          infoModal?.addEventListener('click', (e) => {
            if (e.target === infoModal) infoModal.close();
          });

          // Keyboard Shortcuts
          window.addEventListener('keydown', (e) => {
            if (cinematicModal?.open) {
              if (e.key === 'Escape') closeModal();
              if (e.key === 'ArrowRight') modalNext();
              if (e.key === 'ArrowLeft') modalPrev();
              return;
            }
            if (commentModal?.open) {
              if (e.key === 'Escape') closeCommentModal();
              return;
            }
            if (infoModal?.open) {
              if (e.key === 'Escape') infoModal.close();
              return;
            }
            if (e.key === 'Escape') {
              if (viewPhotos?.classList.contains('active')) {
                showWorksView(currentModelId);
              } else if (viewWorks?.classList.contains('active')) {
                showCharactersView();
              }
            }
          });

          // Mouse wheel scroll forward from stage to panel (PC)
          const stage = document.getElementById('main-visual-stage');
          stage?.addEventListener('wheel', (e) => {
            if (window.innerWidth > 960) {
              const activePanel = document.querySelector('.panel-view-section.active');
              if (activePanel) activePanel.scrollTop += e.deltaY;
            }
          }, { passive: true });
        }

        // Initialize App
        function initApp() {
          renderCharactersView();
          initFloatingDock();
          initCursor();
          init3DTilt();
          initModalGestures();
          setupEventListeners();
          showCharactersView();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initApp);
        } else {
          initApp();
        }

        // Astro page transitions support
        document.addEventListener('astro:page-load', () => {
          initApp();
        });
      })();
    </script>
  </body>
</html>
