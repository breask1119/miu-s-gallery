---
// src/pages/index.astro
import { ClientRouter } from 'astro:transitions';
import '../styles/gallery.css';
import '../styles/app.scss';
import { getGalleryData } from '../lib/wp';

// 1. WordPress (WPGraphQL + REST API ハイブリッド) からデータ取得
const { siteInfo, sliders, models: rawModels } = await getGalleryData();

// 画像URLのHTTPS化およびWordPressオリジン正規化ヘルパー
const wpGraphqlUrl = import.meta.env.PUBLIC_WP_GRAPHQL_URL || '';
const secureUrl = (url: string) => {
  if (!url) return '';
  let httpsUrl = url.replace(/^http:\/\//i, 'https://');
  if (wpGraphqlUrl && !httpsUrl.includes('unsplash.com')) {
    try {
      const wpOrigin = new URL(wpGraphqlUrl).origin;
      const urlObj = new URL(httpsUrl);
      if (urlObj.origin !== wpOrigin) {
        urlObj.protocol = new URL(wpOrigin).protocol;
        urlObj.hostname = new URL(wpOrigin).hostname;
        urlObj.port = new URL(wpOrigin).port;
        return urlObj.toString();
      }
    } catch (e) {}
  }
  return httpsUrl;
};

const placeholderImg = "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop";

const getValidColor = (color: string) => (color && color.trim() !== '') ? color : '#F43F5E';

const hexToRgbString = (hex: string) => {
  const validHex = getValidColor(hex);
  let cleanHex = validHex.replace('#', '');
  if (cleanHex.length === 3) {
    cleanHex = cleanHex.split('').map(c => c + c).join('');
  }
  const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
  const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
  const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
  return `${r}, ${g}, ${b}`;
};

// キャラクター名と英字の対応表（全12モデル対応、表記揺れ対応）
const characterNameMap: Record<string, string> = {
  "美羽": "Miu",
  "美夜": "Miya",
  "美姫": "Miki",
  "美桜": "Mio",
  "美空": "Miku",
  "美玖": "Miku",
  "美英": "Miei",
  "美詠": "Miei",
  "美香": "Mika",
  "美華": "Mika",
  "美緑": "Midori",
  "美鳥": "Midori",
  "未来": "Mirai",
  "美莱": "Mirai",
  "美柚": "Miyuzu",
  "美ゆず": "Miyuzu",
  "美登": "Mito",
  "美豊": "Mito",
  "雪": "Yuki",
  "ユキ": "Yuki",
};

const slugNameMap: Record<string, string> = {
  "miu": "Miu",
  "miya": "Miya",
  "miki": "Miki",
  "mio": "Mio",
  "miku": "Miku",
  "miei": "Miei",
  "mika": "Mika",
  "midori": "Midori",
  "mirai": "Mirai",
  "miyuzu": "Miyuzu",
  "mito": "Mito",
  "yuki": "Yuki",
};

// モデル名を「漢字 / アルファベット (例: 美羽 / Miu)」に整形するヘルパー
const formatModelDisplayName = (name: string, slug?: string) => {
  if (!name) return '';
  const clean = name.trim();
  if (clean.includes('/')) return clean;

  if (characterNameMap[clean]) {
    return `${clean} / ${characterNameMap[clean]}`;
  }

  if (slug) {
    const en = slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
    if (!clean.toLowerCase().includes(slug.toLowerCase())) {
      return `${clean} / ${en}`;
    }
  }

  return clean;
};

// タイトルHTML（漢字とアルファベットを別々のspanにして細身の洗練されたタイポグラフィを適用）
const formatTitleHtml = (displayName: string) => {
  if (!displayName) return '';
  if (displayName.includes(' / ')) {
    const [kanji, romaji] = displayName.split(' / ');
    return `<span class="char-kanji">${kanji}</span><span class="char-divider">/</span><span class="char-romaji">${romaji}</span>`;
  }
  return `<span class="char-kanji">${displayName}</span>`;
};

// キャラクター英名取得ヘルパー（バッジ表示用）
const getRomajiName = (name: string, slug?: string) => {
  if (!name) return 'Miu';
  if (name.includes(' / ')) return name.split(' / ')[1].trim();
  const clean = name.trim();
  if (characterNameMap[clean]) return characterNameMap[clean];
  const lower = clean.toLowerCase();
  if (slugNameMap[lower]) return slugNameMap[lower];
  if (slug && slugNameMap[slug.toLowerCase()]) return slugNameMap[slug.toLowerCase()];
  if (slug && slug !== 'featured') return slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
  return clean.charAt(0).toUpperCase() + clean.slice(1);
};

// WordPressのデータを home-version の 3-Tier UI 用データ構造へ統合変換
// (新方式: artwork_image / 旧方式: variation_images を work.photos に一元化)
const formattedGalleryData = (rawModels && rawModels.length > 0)
  ? rawModels.map((model: any) => {
      const modelId = model.slug || model.id || `model-${Math.random().toString(36).substring(2, 7)}`;
      const displayName = formatModelDisplayName(model.name, model.slug);
      const originalColor = getValidColor(model.memberColor);
      const originalRgb = hexToRgbString(originalColor);
      const avatarSrc = secureUrl(model.modelAvatar?.node?.sourceUrl) || placeholderImg;

      const rawArtworks = model.artworks?.nodes || [];
      const works = rawArtworks.map((art: any, artIdx: number) => {
        const workId = art.slug || art.id || `${modelId}-work-${artIdx + 1}`;
        const dbId = art.databaseId || 0;

        // wp.ts 内で正規化済みの normalizedImages を優先使用
        let photos: any[] = [];
        if (art.normalizedImages && Array.isArray(art.normalizedImages)) {
          photos = art.normalizedImages.map((img: any, pIdx: number) => ({
            id: `${dbId || workId}-${img.id || pIdx}`,
            title: img.title || `${art.title} #${String(pIdx + 1).padStart(2, '0')}`,
            image: secureUrl(img.sourceUrl) || placeholderImg,
            workTitle: art.title,
            modelName: displayName,
            characterId: modelId,
            contentRating: img.contentRating || 'safe',
            sortOrder: img.sortOrder,
            distribution: img.distribution,
          }));
        } else {
          // 旧方式フォールバック
          const cover = secureUrl(art.featuredImage?.node?.sourceUrl) || avatarSrc;
          const varImages = art.orderedImages || art.variationImages?.nodes || [];
          const orderedVarImages = [...varImages].reverse();
          const imgUrls = orderedVarImages.length > 0 ? orderedVarImages.map((v: any) => secureUrl(typeof v === 'string' ? v : v.sourceUrl)) : [cover];
          photos = imgUrls.map((url: string, pIdx: number) => ({
            id: `${dbId || workId}-${pIdx}`,
            title: `${art.title} #${String(pIdx + 1).padStart(2, '0')}`,
            image: url,
            workTitle: art.title,
            modelName: displayName,
            characterId: modelId,
            contentRating: 'safe',
            sortOrder: pIdx + 1,
            distribution: { instagram: true, threads: true, x: true, patreon: 'public' },
          }));
        }

        const coverImage = photos.length > 0 ? photos[0].image : (secureUrl(art.featuredImage?.node?.sourceUrl) || avatarSrc);

        return {
          id: workId,
          databaseId: dbId,
          title: art.title,
          slug: art.slug,
          coverImage: coverImage,
          photos: photos,
          likeCount: art.likeCount || 0,
          guestComments: art.guestComments || [],
          promptData: art.promptData || '',
          hasArtworkImages: Boolean(art.hasArtworkImages),
        };
      });

      return {
        id: modelId,
        dbId: model.id,
        name: displayName,
        rawName: model.name,
        color: originalColor,
        rgb: originalRgb,
        avatar: avatarSrc,
        bio: model.modelBio || '',
        works: works,
      };
    })
  : [];

// トップ画面の自動スライダー用データ
const heroSliderList = (sliders && sliders.length > 0)
  ? sliders.map((s: any, idx: number) => {
      const src = secureUrl(s.featuredImage?.node?.sourceUrl) || placeholderImg;
      const sColor = getValidColor(s.memberColor);
      const matchedModel = rawModels?.find((m: any) => m.name === s.title || m.slug === s.title);
      const displayName = matchedModel
        ? formatModelDisplayName(matchedModel.name, matchedModel.slug)
        : (s.title ? formatModelDisplayName(s.title) : "美羽 / Miu");
      return {
        id: `slider-${idx}`,
        title: s.title || 'Featured',
        image: src,
        workTitle: s.title || 'Featured',
        modelName: displayName,
        characterId: matchedModel?.slug || 'featured',
        color: sColor,
        rgb: hexToRgbString(sColor),
      };
    })
  : formattedGalleryData.map((c: any) => {
      const firstWork = c.works[0] || {};
      const firstPhoto = firstWork.photos?.[0] || { id: c.id, title: c.name, image: c.avatar };
      return {
        ...firstPhoto,
        characterId: c.id,
        modelName: c.name,
        workTitle: firstWork.title || c.name,
        color: c.color,
        rgb: c.rgb,
      };
    });

// 全写真フラット配列
const allPhotosFlat = formattedGalleryData.flatMap((model: any) =>
  model.works.flatMap((work: any) =>
    work.photos.map((photo: any) => ({
      ...photo,
      characterId: model.id,
      modelName: model.name,
      workTitle: work.title,
      databaseId: work.databaseId,
    }))
  )
);

// HTMLエンティティデコード
const decodeHtmlEntities = (str: string) => {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#8217;/g, '’')
    .replace(/&#8216;/g, '‘');
};

const siteTitle = decodeHtmlEntities(siteInfo?.title) || "Miu's Gallery — Fine Photography & Character Archive";
const siteDescription = decodeHtmlEntities(siteInfo?.description) || "枠にとらわれないダイナミックな写真レイアウトと、各キャラクター作品へのシームレスなアクセス性を追求した次世代フォトギャラリー。";
const siteUrl = Astro.site ? Astro.site.toString() : "https://xx-ai-girls-miu.com/";
const ogImageUrl = heroSliderList[0]?.image || placeholderImg;

const schemaLD = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": siteTitle,
  "description": siteDescription,
  "url": siteUrl,
  "image": ogImageUrl,
  "author": {
    "@type": "Person",
    "name": "Miu"
  }
};
